// Saved as UTF-8: the pragma stops windres reading the copyright sign and em dash as ANSI.

#pragma code_page(65001)

#include "resource.h"

// Explorer, taskbar, Alt-Tab and the title bar all read this icon.
IDI_APPICON ICON "icon.ico"

// File properties: what Explorer, Task Manager and Properties -> Details show.
1 VERSIONINFO
 FILEVERSION 1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Charles McDonald"
            VALUE "FileDescription", "Internet Connection Utility — Connection Doctor"
            VALUE "FileVersion", "1.3.0.0"
            VALUE "InternalName", "InternetConnectionUtility"
            VALUE "LegalCopyright", "Copyright © 2026 Charles McDonald. All rights reserved."
            VALUE "OriginalFilename", "InternetConnectionUtility.exe"
            VALUE "ProductName", "Internet Connection Utility"
            VALUE "ProductVersion", "1.3.0.0"
            VALUE "Comments", "Proprietary and confidential software. See LICENSE.md for the terms."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
